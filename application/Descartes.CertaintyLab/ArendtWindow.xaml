<Window x:Class="Descartes.CertaintyLab.ArendtWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Descartes.CertaintyLab"
        Title="{Binding Title}"
        Width="940" Height="720" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="#F3EFE7" Foreground="#25231F"
        FontFamily="Microsoft YaHei UI" FontSize="17">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#344E58" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#344E58" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#111111" />
                    <Setter Property="BorderThickness" Value="4" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="#E7E0D3" />
            <Setter Property="Foreground" Value="#25231F" />
            <Setter Property="BorderBrush" Value="#817667" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFDF8" />
            <Setter Property="BorderBrush" Value="#CAC0AF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#DDE6E7" BorderBrush="#B7C6C8"
                BorderThickness="0,0,0,1" Padding="30,20">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Click="OnCloseExperience"
                        Style="{StaticResource QuietButton}" Margin="20,0,0,0"
                        AutomationProperties.Name="返回体验选择">
                    <local:SilentTextBlock Text="返回体验选择" />
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold"
                               Foreground="#263E46" />
                    <TextBlock Text="一段关于归属、申诉与权利如何生效的思想体验"
                               Margin="0,5,0,0" Foreground="#4E5A5E" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Focusable="False"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="30,24">
            <StackPanel MaxWidth="830">
                <local:AtomicSummaryBorder x:Name="SceneRegion"
                                           Style="{StaticResource Card}"
                                           Focusable="True"
                                           Visibility="{Binding ShowScene, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           AutomationProperties.Name="{Binding SceneAutomationText}">
                    <StackPanel>
                        <local:SilentTextBlock Text="{Binding SceneHeading}" FontSize="23"
                                               FontWeight="Bold" Foreground="#344E58"
                                               Margin="0,0,0,10" />
                        <local:SilentTextBlock Text="{Binding SceneText}"
                                               TextWrapping="Wrap" LineHeight="29" />
                    </StackPanel>
                </local:AtomicSummaryBorder>

                <StackPanel Visibility="{Binding ShowStartingPoints, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap"
                               FontSize="20" FontWeight="SemiBold"
                               LineHeight="29" Margin="0,2,0,14" />
                    <local:ActionItemsControl ItemsSource="{Binding StartingPoints}" Focusable="False">
                        <local:ActionItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ArendtStartingPointViewModel}">
                                <Button Command="{Binding DataContext.ChooseStartingPointCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding AutomationName}"
                                        HorizontalContentAlignment="Stretch">
                                    <local:SilentTextBlock Text="{Binding Text}"
                                                           TextWrapping="Wrap" FontSize="18" />
                                </Button>
                            </DataTemplate>
                        </local:ActionItemsControl.ItemTemplate>
                    </local:ActionItemsControl>
                    <TextBlock Text="{Binding OwnThoughtPrompt}" TextWrapping="Wrap"
                               Foreground="#514B42" Margin="0,8,0,8" />
                    <TextBox Text="{Binding OwnThought, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="140" AcceptsReturn="False"
                             AutomationProperties.Name="我自己的想法，可以留空"
                             AutomationProperties.HelpText="写一句即可，也可以留空后直接继续。"
                             Padding="12,10" MinHeight="46" Margin="0,0,0,10" />
                    <Button Command="{Binding UseOwnThoughtCommand}"
                            Style="{StaticResource QuietButton}"
                            AutomationProperties.Name="{Binding OwnThoughtActionText}">
                        <local:SilentTextBlock Text="{Binding OwnThoughtActionText}" />
                    </Button>
                </StackPanel>

                <Border Style="{StaticResource Card}" Background="#EDF3F3"
                        BorderBrush="#9BB0B4"
                        Visibility="{Binding ShowDiscovery, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding DiscoveryText}" TextWrapping="Wrap"
                               LineHeight="29" AutomationProperties.LiveSetting="Polite" />
                </Border>
                <Button Command="{Binding PrimaryActionCommand}"
                        Visibility="{Binding ShowPrimaryAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="{Binding PrimaryActionText}">
                    <local:SilentTextBlock Text="{Binding PrimaryActionText}" TextWrapping="Wrap" />
                </Button>

                <StackPanel Visibility="{Binding ShowCompletion, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <local:AtomicSummaryBorder x:Name="CompletionRegion"
                                               Style="{StaticResource Card}"
                                               Background="#FFF7E7" BorderBrush="#B8904F"
                                               Focusable="True"
                                               AutomationProperties.Name="{Binding CompletionAutomationText}">
                        <StackPanel>
                            <local:SilentTextBlock Text="{Binding CompletionHeading}"
                                                   FontSize="24" FontWeight="Bold"
                                                   Foreground="#694B18" TextWrapping="Wrap"
                                                   Margin="0,0,0,12" />
                            <local:SilentTextBlock Text="这是谁的什么思想"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#344E58" Margin="0,0,0,8" />
                            <local:SilentTextBlock Text="{Binding CompletionIdentityText}"
                                                   TextWrapping="Wrap" LineHeight="29"
                                                   Margin="0,0,0,20" />
                            <local:SilentTextBlock Text="你刚才发现了什么"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#344E58" Margin="0,0,0,8" />
                            <local:SilentTextBlock Text="{Binding CompletionText}"
                                                   TextWrapping="Wrap" LineHeight="29"
                                                   Margin="0,0,0,20" />
                            <local:SilentTextBlock Text="你从哪里进入了这个问题"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#344E58" Margin="0,0,0,8" />
                            <local:SilentTextBlock Text="{Binding PersonalPathText}"
                                                   TextWrapping="Wrap" LineHeight="28"
                                                   Margin="0,0,0,22" />
                            <local:SilentTextBlock Text="人物经历与思想"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#344E58" Margin="0,0,0,12" />
                            <local:ActionItemsControl ItemsSource="{Binding LifeAndThoughtSteps}">
                                <local:ActionItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:LifeAndThoughtStepDefinition}">
                                        <StackPanel Margin="0,0,0,18">
                                            <local:SilentTextBlock Text="{Binding Heading}"
                                                                   FontSize="18" FontWeight="Bold"
                                                                   Margin="0,0,0,5" />
                                            <local:SilentTextBlock Text="{Binding Body}"
                                                                   TextWrapping="Wrap" LineHeight="28" />
                                        </StackPanel>
                                    </DataTemplate>
                                </local:ActionItemsControl.ItemTemplate>
                            </local:ActionItemsControl>
                            <local:SilentTextBlock Text="这段思想在说什么"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#344E58" Margin="0,4,0,8" />
                            <local:SilentTextBlock Text="{Binding InterpretationText}"
                                                   TextWrapping="Wrap" LineHeight="29"
                                                   Margin="0,0,0,20" />
                            <local:SilentTextBlock Text="它不意味着什么"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#344E58" Margin="0,0,0,8" />
                            <local:SilentTextBlock Text="{Binding BoundaryText}"
                                                   TextWrapping="Wrap" LineHeight="29"
                                                   Margin="0,0,0,14" />
                            <local:SilentTextBlock Text="{Binding CausalBoundary}"
                                                   TextWrapping="Wrap" Foreground="#5B554B"
                                                   LineHeight="28" />
                        </StackPanel>
                    </local:AtomicSummaryBorder>
                    <Button x:Name="SourceButton" Command="{Binding ToggleSourcesCommand}"
                            Style="{StaticResource QuietButton}"
                            AutomationProperties.Name="{Binding SourceButtonText}">
                        <local:SilentTextBlock Text="{Binding SourceButtonText}" />
                    </Button>
                    <local:AtomicSummaryBorder x:Name="SourceNoteRegion"
                                               Style="{StaticResource Card}"
                                               Focusable="True"
                                               Visibility="{Binding ShowSourceNote, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               AutomationProperties.Name="{Binding SourceNoteText}">
                        <local:SilentTextBlock Text="{Binding SourceNoteText}"
                                               TextWrapping="Wrap" LineHeight="28" />
                    </local:AtomicSummaryBorder>
                    <Button x:Name="KnowledgeButton"
                            Click="OnOpenKnowledge"
                            AutomationProperties.Name="继续了解汉娜·阿伦特。打开知识库中的人物、作品与权利思想解析。">
                        <local:SilentTextBlock Text="继续了解汉娜·阿伦特"
                                               TextWrapping="Wrap" />
                    </Button>

                    <Button Command="{Binding RestartCommand}"
                            AutomationProperties.Name="重新经历一次">
                        <local:SilentTextBlock Text="重新经历一次" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
