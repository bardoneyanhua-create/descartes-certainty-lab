<Window x:Class="Descartes.CertaintyLab.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Descartes.CertaintyLab"
        Title="AI 设置" Width="650" Height="690" MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#F3EFE7" Foreground="#25231F"
        FontFamily="Microsoft YaHei UI" FontSize="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="AI 设置" FontSize="30" FontWeight="Bold"
                       Foreground="#263E46" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1"
                       Text="保存不会连接网络。配置变更只对新打开的学习窗口生效。"
                       TextWrapping="Wrap" Margin="0,0,0,18"
                       AutomationProperties.Name="保存不会连接网络。配置变更只对新打开的学习窗口生效。" />

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <Label Target="{Binding ElementName=ModePicker}" Content="模式" />
                <ComboBox x:Name="ModePicker" TabIndex="0" SelectionChanged="OnModeChanged"
                          AutomationProperties.Name="AI 模式">
                    <ComboBoxItem Content="离线演示" Tag="OfflineDemo" />
                    <ComboBoxItem Content="DeepSeek" Tag="DeepSeek" />
                    <ComboBoxItem Content="OpenAI" Tag="OpenAI" />
                    <ComboBoxItem Content="自定义兼容供应商" Tag="CustomOpenAiCompatible" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <Label Target="{Binding ElementName=DisplayNameBox}" Content="配置显示名称" />
                <TextBox x:Name="DisplayNameBox" TabIndex="1"
                         AutomationProperties.Name="配置显示名称" />
            </StackPanel>
            <StackPanel Grid.Row="4" Margin="0,0,0,12">
                <Label Target="{Binding ElementName=BaseUrlBox}" Content="HTTPS 基础网址" />
                <TextBox x:Name="BaseUrlBox" TabIndex="2"
                         AutomationProperties.Name="HTTPS 基础网址"
                         AutomationProperties.HelpText="仅接受公开的绝对 HTTPS 地址，不允许查询、片段、用户信息或私有地址。" />
            </StackPanel>
            <StackPanel Grid.Row="5" Margin="0,0,0,12">
                <Label Target="{Binding ElementName=ModelBox}" Content="模型" />
                <TextBox x:Name="ModelBox" TabIndex="3" AutomationProperties.Name="模型" />
            </StackPanel>
            <StackPanel Grid.Row="6" Margin="0,0,0,12">
                <Label Target="{Binding ElementName=ApiKeyBox}" Content="替换 API key" />
                <PasswordBox x:Name="ApiKeyBox" TabIndex="4"
                             AutomationProperties.Name="替换 API key"
                             AutomationProperties.HelpText="已有密钥不会显示或重新载入。留空表示不替换。" />
                <TextBlock x:Name="ApiKeyStateText" Text="未保存" Margin="0,5,0,0"
                           AutomationProperties.Name="凭据保存状态" />
            </StackPanel>

            <WrapPanel Grid.Row="7" Margin="0,4,0,10">
                <Button x:Name="SaveButton" TabIndex="5" Content="保存" Padding="18,9"
                        Margin="0,0,10,8" Click="OnSave"
                        AutomationProperties.Name="保存 AI 设置，不连接网络" />
                <Button x:Name="TestConnectionButton" TabIndex="6" Content="测试连接" Padding="18,9"
                        Margin="0,0,10,8" Click="OnTestConnection"
                        AutomationProperties.Name="显式测试连接" />
                <Button x:Name="DeleteProfileButton" TabIndex="7" Content="删除配置" Padding="18,9"
                        Margin="0,0,10,8" Click="OnDeleteProfile"
                        AutomationProperties.Name="删除当前配置，需要确认" />
                <Button x:Name="CloseButton" TabIndex="8" Content="关闭" Padding="18,9"
                        Margin="0,0,0,8" Click="OnClose" />
            </WrapPanel>

            <local:AtomicSummaryBorder x:Name="SettingsStatus" Grid.Row="8"
                    Padding="12" BorderBrush="#9BB39F" BorderThickness="1"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{Binding Text, ElementName=StatusText}">
                <TextBlock x:Name="StatusText" Text="配置变更只对新打开的学习窗口生效。"
                           TextWrapping="Wrap" AutomationProperties.Name="AI 设置状态"
                           AutomationProperties.LiveSetting="Polite" />
            </local:AtomicSummaryBorder>
        </Grid>
    </ScrollViewer>
</Window>
