<Window x:Class="Descartes.CertaintyLab.KnowledgeLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Descartes.CertaintyLab"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="知识库" Width="1120" Height="760"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F3EFE7" Foreground="#25231F"
        FontFamily="Microsoft YaHei UI" FontSize="16"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFDF8" />
            <Setter Property="Foreground" Value="#25231F" />
            <Setter Property="BorderBrush" Value="#AFA28E" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,10,8" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#173E49" />
                    <Setter Property="BorderThickness" Value="4" />
                    <Setter Property="Background" Value="#E7F0F1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#173E49" />
                    <Setter Property="BorderThickness" Value="4" />
                    <Setter Property="Background" Value="#E7F0F1" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDE8E5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="知识库" FontSize="32" FontWeight="Bold"
                       Foreground="#263E46" />
            <TextBlock Text="{Binding PageIntroduction}" TextWrapping="Wrap"
                       Margin="0,5,0,16" LineHeight="26" />
            <TextBlock Text="你最近在想什么？" FontSize="21"
                       FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="可以输入一句话，例如“我怎样知道自己不是在做梦？”或“没有国家承认的人怎样行使权利？”"
                       TextWrapping="Wrap" Margin="0,0,0,8" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="43" Padding="10,7"
                     AutomationProperties.Name="知识库搜索。输入一句问题，按回车开始寻找。"
                     KeyDown="OnSearchBoxKeyDown" />
            <Button Grid.Column="1" Content="寻找线索"
                    Command="{Binding SearchCommand}"
                    Click="OnSearchExecuted"
                    AutomationProperties.Name="寻找线索" />
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      MinHeight="43" Padding="8"
                      AutomationProperties.Name="按线索类型筛选" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:AtomicSummaryBorder x:Name="ResultSummaryText"
                                           Focusable="True"
                                           AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.Name="{Binding ResultSummary}"
                                           Margin="0,0,0,8">
                    <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </local:AtomicSummaryBorder>
                <ListBox x:Name="ResultsList" Grid.Row="1"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult}"
                         Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}"
                         PreviewKeyDown="OnResultsListKeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="知识线索结果。用上下方向键浏览，按回车进入完整正文。">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <local:SilentTextBlock Text="{Binding Title}"
                                                       FontWeight="Bold"
                                                       FontSize="18"
                                                       TextWrapping="Wrap" />
                                <local:SilentTextBlock Text="{Binding WhyItAppears}"
                                                       Margin="0,4,0,0"
                                                       Foreground="#4E4A43"
                                                       TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding EmptyStateText}" TextWrapping="Wrap"
                               Margin="0,10,0,8" />
                    <Button Content="浏览全部线索"
                            Command="{Binding ShowAllCommand}"
                            Click="OnSearchExecuted"
                            AutomationProperties.Name="清除搜索并浏览全部线索" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="2"
                    Background="#FFFDF8"
                    BorderBrush="#C8BCA8" BorderThickness="1"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <wv2:WebView2 x:Name="ArticleReader"
                                  Grid.Row="0"
                                  PreviewKeyDown="OnArticleReaderPreviewKeyDown"
                                  AutomationProperties.Name="语义网页知识正文" />
                    <Button x:Name="ExperienceButton"
                            Grid.Row="1"
                            Margin="18,10,18,2"
                            Content="{Binding Detail.ExperienceActionText}"
                            Visibility="{Binding Detail.ShowExperience, Converter={StaticResource BoolToVisibility}}"
                            Click="OpenSelectedExperience"
                            AutomationProperties.Name="{Binding Detail.ExperienceActionText}" />
                    <Button x:Name="SystemLearningButton"
                            Grid.Row="2"
                            Margin="18,10,18,2"
                            Content="{Binding Detail.SystemLearningActionText}"
                            Visibility="{Binding Detail.ShowSystemLearning, Converter={StaticResource BoolToVisibility}}"
                            Click="OpenSystemLearningRoute"
                            AutomationProperties.Name="{Binding Detail.SystemLearningActionText}"
                            AutomationProperties.HelpText="打开固定学习路线；关闭后返回此按钮。" />
                    <TextBlock x:Name="ReaderStatus"
                               Grid.Row="3"
                               Text="在左侧选择线索并按回车阅读正文。"
                               TextWrapping="Wrap"
                               Margin="18,8,18,14"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding CatalogNotice}"
                   TextWrapping="Wrap" Foreground="#5F5A52"
                   FontSize="13" Margin="0,12,0,0" />
    </Grid>
</Window>
