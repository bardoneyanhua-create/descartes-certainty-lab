<Window x:Class="Descartes.CertaintyLab.WebReaderCompatibilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Descartes.CertaintyLab"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="WebView2 正文阅读兼容性测试（第二轮）"
        Width="1120" Height="760"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F3EFE7" Foreground="#25231F"
        FontFamily="Microsoft YaHei UI" FontSize="16">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#173E49" />
                    <Setter Property="BorderThickness" Value="4" />
                    <Setter Property="Background" Value="#E7F0F1" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDE8E5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="WebView2 正文阅读兼容性测试（第二轮）"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#263E46" />
            <TextBlock Text="这是隔离测试，不是正式阅读器。左侧选择人物并按回车，随后直接用保益悦听浏览右侧正文。"
                       TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ResultsList"
                     Grid.Column="0"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult}"
                     PreviewKeyDown="OnResultsListKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="真实知识目录结果。选择一项并按回车进入 WebView2 正文。">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <local:SilentTextBlock Text="{Binding Title}"
                                                   FontWeight="Bold"
                                                   FontSize="18"
                                                   TextWrapping="Wrap" />
                            <local:SilentTextBlock Text="{Binding WhyItAppears}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#4E4A43"
                                                   TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="2"
                    Background="#FFFDF8"
                    BorderBrush="#C8BCA8"
                    BorderThickness="1">
                <wv2:WebView2 x:Name="ArticleReader"
                              PreviewKeyDown="OnArticleReaderPreviewKeyDown"
                              AutomationProperties.Name="语义网页知识正文" />
            </Border>
        </Grid>

        <TextBlock x:Name="ReaderStatus"
                   Grid.Row="2"
                   Text="请选择左侧条目并按回车。"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
