<Window x:Class="Descartes.CertaintyLab.LearningCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Descartes.CertaintyLab"
        Width="760" Height="570"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#F3EFE7" Foreground="#25231F"
        FontFamily="Microsoft YaHei UI" FontSize="17"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFDF8" />
            <Setter Property="Foreground" Value="#25231F" />
            <Setter Property="BorderBrush" Value="#AFA28E" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#173E49" />
                    <Setter Property="BorderThickness" Value="4" />
                    <Setter Property="Background" Value="#E7F0F1" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="34,28">
        <StackPanel MaxWidth="680">
            <TextBlock Text="理解检查" FontSize="30" FontWeight="Bold"
                       Foreground="#263E46" Margin="0,0,0,16" />
            <local:AtomicSummaryBorder x:Name="QuestionHeading"
                                       Focusable="True"
                                       Background="#FFFDF8"
                                       BorderBrush="#C8BCA8"
                                       BorderThickness="1"
                                       Padding="18"
                                       Margin="0,0,0,16">
                <local:SilentTextBlock x:Name="QuestionText"
                                       TextWrapping="Wrap"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       LineHeight="31" />
            </local:AtomicSummaryBorder>
            <StackPanel x:Name="OptionsPanel" />
            <local:AtomicSummaryBorder x:Name="FeedbackHeading"
                                       Focusable="True"
                                       Visibility="Collapsed"
                                       Background="#EEF4EC"
                                       BorderBrush="#9BB39F"
                                       BorderThickness="2"
                                       Padding="18"
                                       Margin="0,0,0,16">
                <StackPanel>
                    <local:SilentTextBlock Text="反馈"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8" />
                    <local:SilentTextBlock x:Name="FeedbackText"
                                           TextWrapping="Wrap"
                                           LineHeight="29" />
                </StackPanel>
            </local:AtomicSummaryBorder>
            <Button x:Name="ContinueButton"
                    Content="继续"
                    Visibility="Collapsed"
                    Click="OnContinue"
                    AutomationProperties.Name="继续到下一道题或返回本章正文" />
            <TextBlock x:Name="CheckStatus"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
